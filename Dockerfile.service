# Generic service Dockerfile — builds ANY of the 5 microservices.
# Pass --build-arg SERVICE=identity|room|game|gateway|bff
#
# Same proven pattern as the original root Dockerfile (which only built
# `game`), generalised so one file serves all five services and CI can
# build them in a matrix.

FROM node:22-alpine AS build
ARG SERVICE
WORKDIR /repo

COPY package.json package-lock.json ./
COPY tsconfig.base.json ./
COPY packages ./packages
COPY services/${SERVICE} ./services/${SERVICE}

RUN npm ci --ignore-scripts

# Build the shared packages first (dependency order matters), then the
# target service. Building engine/events even for services that don't use
# them is harmless — the packages are tiny and this keeps one Dockerfile
# instead of five near-identical ones.
RUN npm run build --workspace @ludo/shared \
 && npm run build --workspace @ludo/kit \
 && npm run build --workspace @ludo/engine \
 && npm run build --workspace @ludo/events \
 && npm run build --workspace @ludo/${SERVICE}

RUN npm prune --omit=dev

FROM node:22-alpine AS runtime
ARG SERVICE
WORKDIR /repo
ENV NODE_ENV=production

RUN addgroup -S app && adduser -S app -G app

COPY --from=build --chown=app:app /repo/node_modules ./node_modules
COPY --from=build --chown=app:app /repo/packages ./packages
COPY --from=build --chown=app:app /repo/services/${SERVICE} ./services/${SERVICE}

USER app
WORKDIR /repo/services/${SERVICE}

CMD ["node", "dist/index.js"]
